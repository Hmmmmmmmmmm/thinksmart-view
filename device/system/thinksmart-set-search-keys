#!/usr/bin/env python3
"""Store the Metaso and Amap keys for the hub's web_search (keys arrive on stdin, two lines; an empty
line keeps the current value). Each key is checked against its service first; nothing is printed
except OK/failed. Then the user hub restarts so the keys take effect."""
import json, os, pwd, re, stat, subprocess, sys, time, urllib.error, urllib.parse, urllib.request

C = '/home/ubuntu/xiaozhi-hub-server/main/xiaozhi-server/data/.config.yaml'
BACKUP_DIR = '/var/backups/thinksmart-claude-20261105-voice'
noproxy = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def check_metaso(k):
    req = urllib.request.Request(
        'https://metaso.cn/api/v1/search',
        method='POST',
        data=json.dumps({'q': '北京天气', 'size': 2, 'scope': 'webpage', 'stream': False}).encode(),
        headers={'Authorization': 'Bearer ' + k, 'Content-Type': 'application/json'},
    )
    try:
        with noproxy.open(req, timeout=15) as resp:
            d = json.loads(resp.read(65536))
        if not isinstance(d, dict):
            return False, 'invalid JSON'
        return bool(d.get('webpages')), f"{len(d.get('webpages') or [])} 条结果"
    except urllib.error.HTTPError as e:
        code = e.code
        e.close()
        return False, f'HTTP {code}'
    except Exception as e:
        return False, type(e).__name__


def check_amap(k):
    q = urllib.parse.urlencode({'key': k, 'keywords': '天安门', 'city': '北京', 'offset': 1})
    try:
        with noproxy.open('https://restapi.amap.com/v3/place/text?' + q, timeout=15) as resp:
            d = json.loads(resp.read(65536))
        if not isinstance(d, dict):
            return False, 'invalid JSON'
        return d.get('status') == '1', (f"{d.get('count')} 个地点" if d.get('status') == '1' else str(d.get('info')))
    except urllib.error.HTTPError as e:
        code = e.code
        e.close()
        return False, f'HTTP {code}'
    except Exception as e:
        return False, type(e).__name__


def _open_parent_dir_nofollow(path: str):
    norm = os.path.abspath(path)
    parts = [p for p in norm.split('/') if p]
    if len(parts) < 2:
        raise OSError('Invalid config path')
    dfd = os.open('/', os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0))
    try:
        for comp in parts[:-1]:
            nxt = os.open(
                comp,
                os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0) | getattr(os, 'O_NOFOLLOW', 0),
                dir_fd=dfd,
            )
            os.close(dfd)
            dfd = nxt
        return dfd, parts[-1]
    except BaseException:
        os.close(dfd)
        raise


def update_config_keys(config_path: str, ok_keys: dict, backup_dir: str = BACKUP_DIR, owner_user: str = 'ubuntu') -> None:
    try:
        dfd, leaf = _open_parent_dir_nofollow(config_path)
    except OSError:
        sys.exit('配置文件目录路径异常（含符号链接或不存在），已拒绝写入')
    try:
        try:
            cfd = os.open(leaf, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_NONBLOCK', 0), dir_fd=dfd)
        except OSError:
            sys.exit('配置文件路径异常（符号链接或无法打开），已拒绝写入')
        with os.fdopen(cfd, 'rb') as f:
            st_c = os.fstat(f.fileno())
            if not stat.S_ISREG(st_c.st_mode) or st_c.st_size > 1048576:
                sys.exit('配置文件不是常规小文件，已拒绝写入')
            raw_bytes = f.read(1048577)
            if len(raw_bytes) > 1048576:
                sys.exit('配置文件过大，已拒绝写入')
        raw_cfg = raw_bytes.decode('utf-8')
        trailing_nl = raw_cfg.endswith('\n')
        lines = raw_cfg.splitlines()
        start = next((idx for idx, ln in enumerate(lines) if re.match(r'^  web_search:\s*(?:#.*)?$', ln)), None)
        if start is None:
            sys.exit('配置文件中未找到   web_search: 配置段')
        end = start + 1
        while end < len(lines) and (lines[end].startswith('    ') or not lines[end].strip() or lines[end].lstrip().startswith('#')):
            end += 1
        for field, key in ok_keys.items():
            qkey = "'" + key.replace("'", "''") + "'"
            for i in range(start + 1, end):
                if re.match(rf'^    {re.escape(field)}:\s*', lines[i]):
                    lines[i] = f'    {field}: {qkey}'
                    break
            else:
                ins = end
                while ins > start + 1 and (not lines[ins - 1].strip() or lines[ins - 1].lstrip().startswith('#')):
                    ins -= 1
                lines.insert(ins, f'    {field}: {qkey}')
                end += 1
        backup = f'{backup_dir}/config.before-keys-{time.strftime("%Y%m%d-%H%M%S")}-{os.getpid()}.yaml'
        os.makedirs(os.path.dirname(backup), mode=0o700, exist_ok=True)
        os.chmod(os.path.dirname(backup), 0o700)
        bfd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0), 0o600)
        with os.fdopen(bfd, 'w', encoding='utf-8') as bf:
            os.fchmod(bf.fileno(), 0o600)
            bf.write(raw_cfg)
        pw = pwd.getpwnam(owner_user) if owner_user else None
        tmp_leaf = f'.{leaf}.{os.getpid()}.tmp'
        created = False
        try:
            try:
                st_leaf = os.stat(leaf, dir_fd=dfd, follow_symlinks=False)
                if not stat.S_ISREG(st_leaf.st_mode):
                    sys.exit('配置文件路径异常（符号链接），已拒绝写入')
            except FileNotFoundError:
                sys.exit('配置文件不存在，已拒绝写入')
            try:
                st_tmp = os.stat(tmp_leaf, dir_fd=dfd, follow_symlinks=False)
                if not stat.S_ISDIR(st_tmp.st_mode):
                    os.unlink(tmp_leaf, dir_fd=dfd)
            except FileNotFoundError:
                pass
            fd = os.open(tmp_leaf, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0), 0o600, dir_fd=dfd)
            created = True
            if pw is not None and os.geteuid() == 0:
                os.fchown(fd, pw.pw_uid, pw.pw_gid)
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, 'w', encoding='utf-8') as tf:
                tf.write('\n'.join(lines) + ('\n' if trailing_nl else ''))
                tf.flush()
                os.fsync(tf.fileno())
            st_leaf2 = os.stat(leaf, dir_fd=dfd, follow_symlinks=False)
            if not stat.S_ISREG(st_leaf2.st_mode):
                sys.exit('配置文件路径异常（符号链接），已拒绝写入')
            os.replace(tmp_leaf, leaf, src_dir_fd=dfd, dst_dir_fd=dfd)
            created = False
        finally:
            if created:
                try:
                    os.unlink(tmp_leaf, dir_fd=dfd)
                except OSError:
                    pass
    finally:
        os.close(dfd)


def main():
    if os.geteuid() != 0:
        sys.exit('请使用 sudo 运行此脚本（sudo /usr/local/sbin/thinksmart-set-search-keys）')
    metaso, amap = (sys.stdin.readline().strip(), sys.stdin.readline().strip())
    ok_keys = {}
    for name, field, key, check in (('秘塔', 'metaso_key', metaso, check_metaso), ('高德', 'amap_key', amap, check_amap)):
        if not key:
            print(f'{name}：没输入，保持原样')
            continue
        if not re.fullmatch(r'[\x21-\x7e]{8,200}', key):
            print(f'{name}：格式不对（有空格或中文？），没保存')
            continue
        good, info = check(key)
        print(f'{name}：{"验证通过" if good else "验证失败"}（{info}）' + ('' if good else '，没保存'))
        if good:
            ok_keys[field] = key
    if not ok_keys:
        sys.exit(0)
    update_config_keys(C, ok_keys)
    print('已写入小麦的私有配置，正在重启小麦后台（约 15 秒）…')
    env = dict(os.environ, XDG_RUNTIME_DIR='/run/user/1000', DBUS_SESSION_BUS_ADDRESS='unix:path=/run/user/1000/bus')
    subprocess.run(
        ['sudo', '-u', 'ubuntu', '--preserve-env=XDG_RUNTIME_DIR,DBUS_SESSION_BUS_ADDRESS', 'systemctl', '--user', 'restart', 'xiaozhi-hub'],
        env=env,
        check=True,
    )
    print('完成。')


if __name__ == '__main__':
    main()
