[Unit]
Description=TAS5782M chip warm-up (one-shot, pre-initializes DSP at login)
Documentation=https://github.com/local/cd18781y-audio
After=wireplumber.service pipewire-pulse.service pipewire.service
Requires=wireplumber.service pipewire.service

[Service]
Type=oneshot
RemainAfterExit=no
# Wait a moment for WirePlumber to finish connecting to PipeWire
ExecStartPre=/bin/sleep 3
# Stream 700 ms of pure digital silence (48 kHz S16LE stereo) to force PCM open
# and clock BCLK long enough (>546 ms) for TAS5782M DSP init without audible sound.
# With node.pause-on-idle=false already set, PipeWire keeps the PCM running
# after this exits, so the chip stays in PLAY mode indefinitely.
ExecStart=/bin/bash -c 'dd if=/dev/zero bs=4800 count=28 status=none | pacat --playback --raw --format=s16le --rate=48000 --channels=2 2>/dev/null || true'

[Install]
WantedBy=default.target
