[Unit]
Description=ThinkSmart Nezha read-only touchscreen monitor
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 NEZHA_HOST=nezha.example.com
ExecStart=/opt/thinksmart-addons/venv/bin/python /usr/local/bin/thinksmart-monitor.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=thinksmart-monitor
StateDirectoryMode=0700
MemoryMax=96M
TasksMax=24

[Install]
WantedBy=multi-user.target
